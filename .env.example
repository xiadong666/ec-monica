# ===========================================================================
# EC-Monica 环境变量模板
#
# 用法：copy .env.example .env  然后按需修改
#
# ⚠️⚠️ 本文件是**模板**，必须保持为空值，绝不写入真实密钥。
#      .env.example 通常会被提交到版本库，写入真实 Key 等于公开泄露。
#      真实密钥只放 .env（已在 .gitignore / .dockerignore 中排除）。
# ===========================================================================

# ===========================================================================
# LLM
# ===========================================================================

# DeepSeek API Key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=

# 模型：必须支持 Function Calling（deepseek-chat / V3）
# 注意：deepseek-reasoner（R1）不支持工具调用，不能用于 Agent
EC_LLM_MODEL=deepseek-chat
EC_LLM_MODEL_CHEAP=deepseek-chat

# ===========================================================================
# 数据
# ===========================================================================

EC_DB_PATH=data/ec.db

# ===========================================================================
# 安全（生产环境必须配置）
# ===========================================================================

# JWT 签名密钥。**必须修改**，建议 32 字节以上随机串。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 未配置时会生成临时密钥 —— 重启后所有 Token 失效，多副本签名也不一致。
EC_JWT_SECRET=

# 用户配置（JSON）。留空则启用开发默认账号（admin/analyst/viewer，弱口令）。
# 生产环境**必须**配置此项。
#
# 生成密码哈希：
#   python -c "from app.auth import hash_password; print(hash_password('你的密码'))"
#
# 字段说明：
#   role            : admin | analyst | viewer
#   categories      : 数据权限白名单（null = 不限制）
#   channels        : 渠道白名单（null = 不限制）
#   daily_llm_quota : 每日 LLM 调用配额（0 = 不允许调用工作流接口）
#   disabled        : 是否停用
#
# EC_USERS={"alice":{"password_hash":"pbkdf2_sha256$200000$...","role":"admin","display_name":"Alice"},
#           "bob":{"password_hash":"pbkdf2_sha256$200000$...","role":"analyst","display_name":"Bob","categories":["美妆","家居"],"daily_llm_quota":100}}

# ===========================================================================
# 会话存储
# ===========================================================================

# memory（默认，仅单实例可用） | redis（多副本必须）
EC_SESSION_BACKEND=memory
EC_REDIS_URL=redis://127.0.0.1:6379/0
# 会话有效期（秒），默认 8 小时
EC_SESSION_TTL=28800

# ===========================================================================
# 可观测性
# ===========================================================================

# DEBUG | INFO | WARNING | ERROR
EC_LOG_LEVEL=INFO

# 审计日志落盘路径。留空则写 stderr。
# ★ 生产环境建议写入独立的追加型存储（不可篡改、保留期远长于普通日志）
EC_AUDIT_LOG=data/audit.log
